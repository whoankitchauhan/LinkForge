# ─── LinkForge — Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# Only DATABASE_URL and JWT secrets are required.

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database — REQUIRED
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/linkforge_db

# JWT — REQUIRED
# Generate with: node -e "require('crypto').randomBytes(48).toString('hex') |> console.log"
# Or online: https://generate-secret.vercel.app/96
JWT_ACCESS_SECRET=GENERATE_A_RANDOM_96_CHAR_HEX_STRING
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_RANDOM_96_CHAR_HEX_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App Config
BCRYPT_ROUNDS=10
SHORT_CODE_LENGTH=7
DEFAULT_SLUG_TYPE=BASE62
QR_OUTPUT_DIR=public/qr
CORS_ORIGINS=http://localhost:3000
