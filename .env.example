# ========================================================
# LinkForge Enterprise — Environment Variables
# Copy this file to .env and fill in your values
# ========================================================

# ─── Application ─────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://linkforge:linkforge_secret@localhost:5432/linkforge_db

# ─── Redis ───────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTL (seconds)
CACHE_TTL=86400

# ─── RabbitMQ ────────────────────────────────────────────
RABBITMQ_URL=amqp://linkforge:linkforge_secret@localhost:5672
RABBITMQ_EXCHANGE=linkforge_events
RABBITMQ_QUEUE_ANALYTICS=analytics_queue
RABBITMQ_QUEUE_NOTIFICATIONS=notifications_queue

# ─── JWT ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM=noreply@linkforge.io
EMAIL_FROM_NAME=LinkForge

# ─── Rate Limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_URL_CREATE=50
RATE_LIMIT_AUTH_LOGIN=10
RATE_LIMIT_REDIRECT=200

# ─── URL Generation ──────────────────────────────────────
SHORT_CODE_LENGTH=7
DEFAULT_SLUG_TYPE=BASE62
BASE_DOMAIN=linkforge.io

# ─── QR Code ─────────────────────────────────────────────
QR_OUTPUT_DIR=public/qr

# ─── Prometheus ──────────────────────────────────────────
METRICS_PORT=9090

# ─── Bcrypt ──────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Security ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Workers ─────────────────────────────────────────────
EXPIRATION_WORKER_INTERVAL_MS=60000
CACHE_SYNC_TOP_N=100
