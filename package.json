{
  "name": "linkforge",
  "version": "1.0.0",
  "description": "LinkForge Enterprise — Distributed URL Shortening, Analytics, QR Management & Traffic Intelligence Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:workers": "nodemon services/analytics/worker.js & nodemon services/notification/worker.js & nodemon services/workers/expirationWorker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest tests/unit --forceExit",
    "test:integration": "jest tests/integration --runInBand --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "test:load": "artillery run tests/load/artillery.yml",
    "lint": "eslint . --ext .js",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nanoid": "^3.3.7",
    "nodemailer": "^6.9.13",
    "prom-client": "^15.1.2",
    "qrcode": "^1.5.3",
    "ua-parser-js": "^1.0.38",
    "uuid": "^11.0.0",
    "winston": "^3.13.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "artillery": "^2.0.13",
    "eslint": "^9.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "prettier": "^3.3.0",
    "prisma": "^5.14.0",
    "puppeteer": "^25.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFiles": [
      "./tests/setup.js"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": "Ankit Chauhan"
}
